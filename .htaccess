### PROTECT FILES ###
<FilesMatch "\.(htaccess|htpasswd|ini|fla|psd|log|sh)$">
Order Allow, Deny
Deny from all
</FilesMatch>

RewriteEngine on
RewriteRule strona-glowna index.html
RewriteRule zyczenia-dla-karusi zyczenia.html
RewriteRule podziekowania-dla-karusi podziekowania.html
RewriteRule co-wiem-o-karusi quiz-wiedzy.html
RewriteRule kim-ja-jestem o-mnie.html